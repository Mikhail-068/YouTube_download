<Window x:Class="YoutubeDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YouTube Downloader" Height="760" Width="940" MinHeight="640" MinWidth="780"
        Icon="YouTube.ico"
        WindowStartupLocation="CenterScreen" Background="#0F0F0F" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="Assets/WindowBackground.png" Stretch="Uniform"
                        Viewport="0,0,308,184.03" ViewportUnits="Absolute" TileMode="FlipXY" Opacity="0.85" />
        </Grid.Background>

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Шапка с названием и значком воспроизведения -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>
                <Image x:Name="PlayBadge" Source="Assets/YouTubeMark.png" Width="48" Height="34"
                       Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderTitle" Grid.Column="1" Margin="8,0,0,0"
                           FontFamily="Bahnschrift, Segoe UI" FontStretch="Condensed" FontSize="30"
                           FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
                    <Run Text="YouTube" /><Run Text=" Downloader" Foreground="#ED5A52" />
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="8,2,0,0" Foreground="#D0D0D0" FontSize="13"
                           Text="Скачивайте видео и аудио в выбранную папку" />
                <StackPanel Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock x:Name="SessionStatusTextBlock" Text="Файл сессии подключён"
                               Visibility="Collapsed" Margin="0,0,12,0" Foreground="#D0D0D0"
                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="SessionButton" Content="Сессия YouTube"
                            ToolTip="Выбрать браузер, профиль или файл сессии YouTube"
                            Click="SessionButton_Click" Style="{StaticResource GlossyButton}"
                            Padding="12,6" FontSize="12" Background="#252932" BorderBrush="#777E8D" />
                </StackPanel>
            </Grid>

            <!-- Поле ссылки + Проверить -->
            <Grid Grid.Row="1" Margin="0,26,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="UrlTextBox" Height="52" Margin="0,0,10,0" Style="{StaticResource SilverInputField}"
                         Foreground="#FFFFFF" ToolTip="Вставьте ссылку на видео или плейлист" />
                <Button x:Name="InfoButton" Grid.Column="1" Style="{StaticResource CheckButtonStyle}"
                        Click="InfoButton_Click" Content="Проверить" />
            </Grid>

            <!-- Карточка видео -->
            <Border x:Name="VideoCard" Grid.Row="2" Style="{StaticResource YouTubeCard}"
                    BorderBrush="{StaticResource SilverEdgeBrush}" BorderThickness="{StaticResource SilverEdgeThickness}"
                    Margin="0,18,0,0">
                <Border.Background>
                    <DrawingBrush Stretch="Uniform" Viewport="0,0,300,300" ViewportUnits="Absolute" TileMode="FlipXY">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#07080C" Geometry="M0,0 H300 V300 H0 Z" />
                                <DrawingGroup Opacity="0.42">
                                    <ImageDrawing ImageSource="Assets/VideoCardLeather.png" Rect="0,0,300,300" />
                                </DrawingGroup>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="244" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Height="138" CornerRadius="8" ClipToBounds="True" Background="#000000">
                        <Grid>
                            <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />
                            <Path Data="{StaticResource PlayIcon}" Fill="#88C4302B" Stretch="Uniform" Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="СВЕДЕНИЯ О ВИДЕО" Foreground="#D0D0D0" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="VideoTitleTextBlock" Text="Вставьте ссылку и нажмите «Проверить»" Margin="0,7,0,0" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock x:Name="VideoDetailsTextBlock" Text="Обложка и длительность появятся здесь." Margin="0,8,0,0" Foreground="#D0D0D0" TextWrapping="Wrap" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Поле папки -->
            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="FolderTextBox" Height="50" Margin="0,0,10,0"
                         Style="{StaticResource SilverInputField}" Foreground="#FFFFFF" />
                <Button Grid.Column="1" Style="{StaticResource FolderButtonStyle}" Click="ChooseFolder_Click"
                        AutomationProperties.Name="Выбрать папку сохранения" ToolTip="Выбрать папку сохранения" />
            </Grid>

            <!-- Кнопки действий -->
            <Grid Grid.Row="4" Margin="0,22,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <WrapPanel>
                    <Button x:Name="DownloadButton" Style="{StaticResource VideoButtonStyle}" Margin="0,0,12,0" Click="DownloadButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource DownloadIcon}" Fill="White" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Скачать видео" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AudioButton" Style="{StaticResource AudioButtonStyle}" Margin="0,0,12,0" Click="AudioButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource MusicIcon}" Fill="#F1F1F1" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Скачать MP3" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Style="{StaticResource CancelButtonStyle}" Margin="0,0,12,0" IsEnabled="False" Click="CancelButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource StopIcon}" Fill="#F1F1F1" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Отменить" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UpdateButton" Style="{StaticResource UpdateButtonStyle}" Click="UpdateButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource RefreshIcon}" Fill="#F1F1F1" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Обновить yt-dlp" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Статус + прогресс -->
                <StackPanel Grid.Row="1" Margin="0,18,0,14">
                    <TextBlock x:Name="StatusTextBlock" Text="Готово к работе" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <ProgressBar x:Name="ActivityProgressBar" Height="3" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" BorderThickness="0" Foreground="#C4302B" Background="#303030" />
                </StackPanel>

                <!-- Лог -->
                <Border Style="{StaticResource YouTubeCard}" Grid.Row="2" Padding="0"
                        Background="#0F0F0F" BorderBrush="{StaticResource SilverEdgeBrush}"
                        BorderThickness="{StaticResource SilverEdgeThickness}">
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" Background="Transparent" Foreground="#E8E8E8"
                             BorderThickness="0" FontFamily="Cascadia Mono" FontSize="12" Padding="16,5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
