<Application x:Class="YoutubeDownloader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Палитра YouTube (тёмная тема) ===== -->
            <SolidColorBrush x:Key="YouTubeRedBrush" Color="#C4302B" />
            <SolidColorBrush x:Key="YouTubeRedDarkBrush" Color="#9E2620" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#212121" />
            <SolidColorBrush x:Key="CardBrush" Color="#272727" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#303030" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#B8B8B8" />

            <!-- ===== Глобальный светлый текст (чтобы нигде не было чёрного) ===== -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F1F1F1" />
            </Style>

            <!-- ===== Иконки (Material Design, 24x24) ===== -->
            <Geometry x:Key="PlayIcon">M8 5v14l11-7z</Geometry>
            <Geometry x:Key="DownloadIcon">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</Geometry>
            <Geometry x:Key="MusicIcon">M12 3v10.55c-.59-.34-1.27-.55-2-.55a4 4 0 1 0 4 4V7h4V3h-6z</Geometry>
            <Geometry x:Key="StopIcon">M6 6h12v12H6z</Geometry>
            <Geometry x:Key="RefreshIcon">M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.74 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</Geometry>
            <Geometry x:Key="SearchIcon">M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 5L20.49 19l-5-5zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14z</Geometry>
            <Geometry x:Key="FolderIcon">M10 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-8l-2-2z</Geometry>

            <!-- ===== Текстовое поле (как поиск YouTube) ===== -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#0F0F0F" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
                <Setter Property="CaretBrush" Value="#C4302B" />
                <Setter Property="SelectionBrush" Value="#99C4302B" />
                <Setter Property="BorderBrush" Value="#303030" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#C4302B" />
                        <Setter Property="BorderThickness" Value="2" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Кнопка (общий шаблон YouTube) ===== -->
            <Style x:Key="YouTubeButton" TargetType="Button">
                <Setter Property="Foreground" Value="#F1F1F1" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="18,11" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Border x:Name="bd"
                                        CornerRadius="18"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        Background="{TemplateBinding Background}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.1" />
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.06" />
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.06" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.1" />
                                                <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Главная кнопка: фирменный красный YouTube -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource YouTubeButton}">
                <Setter Property="Background" Value="#C4302B" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#9E2620" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Вторичная кнопка: тёмная пилюля (как на YouTube) -->
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource YouTubeButton}">
                <Setter Property="Background" Value="#272727" />
                <Setter Property="Foreground" Value="#F1F1F1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3F3F3F" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Карточка (как surface YouTube) ===== -->
            <Style x:Key="YouTubeCard" TargetType="Border">
                <Setter Property="Background" Value="#212121" />
                <Setter Property="BorderBrush" Value="#303030" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
