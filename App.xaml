<Application x:Class="YoutubeDownloader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== Палитра YouTube (тёмная тема) ===== -->
            <SolidColorBrush x:Key="YouTubeRedBrush" Color="#C4302B" />
            <SolidColorBrush x:Key="YouTubeRedDarkBrush" Color="#9E2620" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#212121" />
            <SolidColorBrush x:Key="CardBrush" Color="#272727" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#303030" />
            <LinearGradientBrush x:Key="SilverEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#A3AAB5" Offset="0" />
                <GradientStop Color="#686F7B" Offset="0.62" />
                <GradientStop Color="#8B929D" Offset="1" />
            </LinearGradientBrush>
            <Thickness x:Key="SilverEdgeThickness">0.5</Thickness>
            <CornerRadius x:Key="PanelCornerRadius">12</CornerRadius>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#B8B8B8" />

            <!-- ===== Глобальный светлый текст (чтобы нигде не было чёрного) ===== -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F1F1F1" />
            </Style>

            <!-- ===== Иконки (Material Design, 24x24) ===== -->
            <Geometry x:Key="PlayIcon">M8 5v14l11-7z</Geometry>
            <Geometry x:Key="DownloadIcon">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</Geometry>
            <Geometry x:Key="MusicIcon">M12 3v10.55c-.59-.34-1.27-.55-2-.55a4 4 0 1 0 4 4V7h4V3h-6z</Geometry>
            <Geometry x:Key="StopIcon">M6 6h12v12H6z</Geometry>
            <Geometry x:Key="RefreshIcon">M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.74 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</Geometry>

            <!-- ===== Текстовое поле (как поиск YouTube) ===== -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#0F0F0F" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
                <Setter Property="CaretBrush" Value="#C4302B" />
                <Setter Property="SelectionBrush" Value="#99C4302B" />
                <Setter Property="BorderBrush" Value="#303030" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#C4302B" />
                        <Setter Property="BorderThickness" Value="2" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SilverInputField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="BorderBrush" Value="{StaticResource SilverEdgeBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SilverEdgeThickness}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="FieldFrame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource PanelCornerRadius}">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="#D3DAE4" />
                        <Setter Property="BorderThickness" Value="{StaticResource SilverEdgeThickness}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GlossyButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="18,11" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Chrome" SnapsToDevicePixels="True">
                                <Grid.RenderTransform>
                                    <TranslateTransform />
                                </Grid.RenderTransform>
                                <Border x:Name="Face" CornerRadius="32" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{Binding Path=BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ShadowDepth="2" Direction="270" BlurRadius="12" Opacity="0.36" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="Gloss" Margin="2,2,2,4" CornerRadius="30"
                                        Opacity="0.86" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#63FFFFFF" Offset="0" />
                                            <GradientStop Color="#14FFFFFF" Offset="0.36" />
                                            <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                            <GradientStop Color="#30000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Margin="3,2,3,4" CornerRadius="30" BorderThickness="1"
                                        IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0.1" EndPoint="1,0.9">
                                            <GradientStop Color="#3EFFFFFF" Offset="0" />
                                            <GradientStop Color="#EAFFFFFF" Offset="0.23" />
                                            <GradientStop Color="#78FFFFFF" Offset="0.47" />
                                            <GradientStop Color="#35FFFFFF" Offset="0.79" />
                                            <GradientStop Color="#56FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>
                                <Border x:Name="FocusRing" Margin="-3" CornerRadius="35" BorderThickness="2"
                                        BorderBrush="#F5F8FF" Visibility="Collapsed" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Gloss" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Gloss" Property="Opacity" Value="0.4" />
                                    <Setter TargetName="Chrome" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="Face" Property="Effect" Value="{x:Null}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CheckButtonStyle" TargetType="Button" BasedOn="{StaticResource GlossyButton}">
                <Setter Property="Width" Value="113" />
                <Setter Property="Height" Value="40" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="#FFE5A2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="CheckChrome" Background="Transparent" SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox Width="34" Height="34">
                                        <Canvas Width="46" Height="46">
                                            <Path x:Name="MagnifierOutline"
                                                  Data="M34.5,18.5 A15.5,15.5 0 1 1 3.5,18.5 A15.5,15.5 0 1 1 34.5,18.5 Z
                                                        M30.8,28.5 L35.8,33.5 M28.9,30.4 L33.9,35.4
                                                        M33,36.3 L37,32.3 L43.8,39.1 Q46.5,41.8 44.5,43.8 Q42.5,45.8 39.8,43.1 Z"
                                                  Stroke="#F5CD54" StrokeThickness="1.25" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MagnifierOutline" Property="Stroke" Value="#FFE5A2" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="MagnifierOutline" Property="Opacity" Value="0.75" />
                                    <Setter TargetName="CheckChrome" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="MagnifierOutline" Property="Stroke" Value="#FFF6DF" />
                                    <Setter TargetName="MagnifierOutline" Property="StrokeThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="CheckChrome" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FolderButtonStyle" TargetType="Button" BasedOn="{StaticResource GlossyButton}">
                <Setter Property="Width" Value="74" />
                <Setter Property="Height" Value="40" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="FolderChrome" Background="Transparent" SnapsToDevicePixels="True">
                                <Viewbox IsHitTestVisible="False">
                                    <Canvas Width="94" Height="50">
                                        <Path x:Name="FolderOutline"
                                              Data="M17,43 V9 Q17,3 23,3 H34 Q37,3 39,5 L44,9 H65 Q72,9 72,15 V16 H75 Q80,16 78,22 L73,43 Q72,47 68,47 H22 Q17,47 17,43 Z
                                                    M17,43 L23,20 Q24,16 29,16 H72"
                                              Stroke="#F5CD54" StrokeThickness="1.25" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="FolderOutline" Property="Stroke" Value="#FFE5A2" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="FolderOutline" Property="Opacity" Value="0.75" />
                                    <Setter TargetName="FolderChrome" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FolderOutline" Property="Stroke" Value="#FFF6DF" />
                                    <Setter TargetName="FolderOutline" Property="StrokeThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="FolderChrome" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="VideoButtonStyle" TargetType="Button" BasedOn="{StaticResource GlossyButton}">
                <Setter Property="BorderBrush" Value="#FF5B2D" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#A32113" Offset="0" />
                            <GradientStop Color="#CF420B" Offset="0.45" />
                            <GradientStop Color="#A11914" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AudioButtonStyle" TargetType="Button" BasedOn="{StaticResource GlossyButton}">
                <Setter Property="BorderBrush" Value="#A76AFF" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#4B11A5" Offset="0" />
                            <GradientStop Color="#7827CB" Offset="0.45" />
                            <GradientStop Color="#440C9C" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource GlossyButton}">
                <Setter Property="BorderBrush" Value="#777985" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#202026" Offset="0" />
                            <GradientStop Color="#43434D" Offset="0.45" />
                            <GradientStop Color="#1E1E25" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource GlossyButton}">
                <Setter Property="BorderBrush" Value="#38B662" />
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#0C4B29" Offset="0" />
                            <GradientStop Color="#11733C" Offset="0.45" />
                            <GradientStop Color="#0C462D" Offset="1" />
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Карточка (как surface YouTube) ===== -->
            <Style x:Key="YouTubeCard" TargetType="Border">
                <Setter Property="Background" Value="#212121" />
                <Setter Property="BorderBrush" Value="#303030" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <SolidColorBrush x:Key="SessionMenuSurface" Color="#20242D" />
            <SolidColorBrush x:Key="SessionMenuBorder" Color="#626B7C" />
            <SolidColorBrush x:Key="SessionMenuHighlight" Color="#353E4F" />
            <SolidColorBrush x:Key="SessionMenuText" Color="#F3F4F7" />
            <SolidColorBrush x:Key="SessionMenuDisabledText" Color="#A5ADBD" />

            <Style x:Key="SessionMenuItem" TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource SessionMenuText}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid SnapsToDevicePixels="True">
                                <Border x:Name="Row" Background="Transparent" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                        </Grid.ColumnDefinitions>
                                        <Path x:Name="SelectedMark" Data="M0,4 L3,7 L9,0"
                                              Stroke="#E8BE69" StrokeThickness="1.5" VerticalAlignment="Center"
                                              Visibility="Collapsed" />
                                        <AccessText Grid.Column="1" Text="{TemplateBinding Header}"
                                                    Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                                    Margin="0,0,10,0" MaxWidth="300"
                                                    TextTrimming="CharacterEllipsis" />
                                        <Path x:Name="SubmenuArrow" Grid.Column="2" Data="M0,0 L4,4 L0,8"
                                              Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Right"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True"
                                       Focusable="False">
                                    <Border Background="{StaticResource SessionMenuSurface}"
                                            BorderBrush="{StaticResource SessionMenuBorder}" BorderThickness="1"
                                            CornerRadius="7" Padding="4" MinWidth="190" MaxHeight="420">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SessionMenuHighlight}" />
                                </Trigger>
                                <Trigger Property="IsSubmenuOpen" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SessionMenuHighlight}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource SessionMenuDisabledText}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SessionContextMenu" TargetType="ContextMenu">
                <Style.Resources>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource SessionMenuItem}" />
                    <Style TargetType="Separator">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Separator">
                                    <Border Background="{StaticResource SessionMenuBorder}" Opacity="0.5"
                                            Height="1" Margin="9,4" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Style.Resources>
                <Setter Property="MinWidth" Value="235" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{StaticResource SessionMenuSurface}"
                                    BorderBrush="{StaticResource SessionMenuBorder}" BorderThickness="1"
                                    CornerRadius="7" Padding="4" SnapsToDevicePixels="True">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
