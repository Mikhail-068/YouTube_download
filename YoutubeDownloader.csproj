<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <AssemblyName>YoutubeDownloader</AssemblyName>
    <Version>1.0.15</Version>
    <ApplicationIcon>YouTube.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="YouTube.ico" />
    <Resource Include="Assets/WindowBackground.png" />
    <Resource Include="Assets/VideoCardLeather.png" />
  </ItemGroup>
</Project>
